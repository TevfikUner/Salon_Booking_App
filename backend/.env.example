# Kopyalayın: cp .env.example .env  — .env git'e EKLENMEZ.

# development | production
ORTAM=development

# Geliştirme: SQLite. Production: Render/Docker PostgreSQL adresi.
DATABASE_URL=sqlite:///./berber_yeni.db
# DATABASE_URL=postgresql://berber:sifre@localhost:5432/berber

# firebase: ID token Firebase ile doğrulanır (production'da ZORUNLU)
# dev: yerel geliştirme — token imzası doğrulanmaz, "Bearer dev:<uid>" kabul edilir
AUTH_MODE=dev

# Admin rolündeki Firebase kullanıcılarının UID'leri (virgülle)
ADMIN_UIDS=
# İsteğe bağlı eski X-Admin-Secret yolu. Boş = kapalı. Kullanacaksanız uzun rastgele bir değer verin.
ADMIN_SECRET=

# Firebase servis hesabı: ya dosya yolu ya da JSON içeriğinin tamamı (tek satır)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON=

# Web istemcileri için izinli origin'ler (mobil uygulama CORS'tan etkilenmez)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Ters proxy arkasında X-Forwarded-For'da sağdan kaç girdiye güvenilir (0 = başlık yok sayılır). Render: 1
GUVENILIR_PROXY_SAYISI=0

# Yüklenen dosyalar: yerel (uploads/) veya s3 (Cloudflare R2 / AWS S3 / MinIO). Bkz. docs/deployment.md "Dosya depolama"
DEPOLAMA=yerel
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ERISIM_ANAHTARI=
S3_GIZLI_ANAHTAR=
S3_GENEL_URL=

ZAMAN_DILIMI=Europe/Istanbul
REZERVASYON_UFKU_GUN=30
SLOT_DK=30
IPTAL_SON_DK=30
ERTELEME_LIMITI=2
SCHEDULER_ENABLED=true

# Kişisel veri (ad, telefon, e-posta, notlar, yorumlar) veritabanında şifreli saklansın mı? Boş = düz.
# Üretmek: python araclar.py anahtar-uret · Açtıktan sonra mevcut veri için: python araclar.py veri-sifrele
# ANAHTAR KAYBOLURSA ŞİFRELİ VERİ OKUNAMAZ — parola yöneticisinde yedekleyin.
VERI_ANAHTARI=
# Anahtar değişiminde eski anahtar(lar), virgülle
VERI_ANAHTARI_ESKI=

# seed.py için: demo yapacağınız gerçek Firebase hesaplarının UID'leri
SEED_ISLETME_UID=demo-isletme
SEED_MUSTERI_UID=demo-musteri
